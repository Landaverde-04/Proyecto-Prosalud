DEBUG=True
SECRET_KEY=tu-clave-secreta-aqui
ALLOWED_HOSTS=localhost,127.0.0.1
# Database (PostgreSQL)
DB_NAME=sistema_prosalud
DB_USER=tu-usuario-db
DB_PASSWORD=tu-password-db
DB_HOST=localhost
DB_PORT=5432
# Adjuntos en Cloudflare R2 (dejar vacío en desarrollo = disco local)
# Nombre del bucket privado donde se guardan los adjuntos
R2_BUCKET=
# Account ID de Cloudflare (va dentro de la dirección del endpoint)
R2_ACCOUNT_ID=
# Access Key ID del token de R2 (Object Read & Write, solo este bucket)
R2_ACCESS_KEY_ID=
# Secret Access Key del mismo token; el valor real solo en el .env
R2_SECRET_ACCESS_KEY=
# Produccion detras del proxy de Render: cookies seguras, redireccion a
# HTTPS y confianza en X-Forwarded-Proto. En desarrollo se deja en False.
DETRAS_DE_PROXY_HTTPS=False
